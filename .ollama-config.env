# SixshotOS Autogen Engine - Ollama Optimizations for 8GB VRAM (RTX 4070)
# Critical: Flash Attention speeds up inference ~20% and reduces peak VRAM
OLLAMA_FLASH_ATTENTION="1"

# Critical: 8-bit quantization of KV cache halves memory usage (~3.2GB vs ~6.4GB for 16k context)
# Without this, OOM will occur after TASK-07 (CAN parser + NMEA sentences)
OLLAMA_KV_CACHE_TYPE="q8_0"

# Recommended: Prevents auto-loading alternate models; ensures consistent agent runtime
OLLAMA_MAX_LOADED_MODELS="1"

# Additional tuning for long context windows (16k tokens in specs + gradle logs):
OLLAMA_CONTEXT_LENGTH="16384"
OLLAMA_NUM_PARALLEL="2"
